rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Existing task documents remain scoped to their signed-in user's UID path.
    match /users/{userId}/appData/{documentId} {
      allow read, write: if isUser(userId);
    }

    function hasValidEventFields(data) {
      return data.keys().hasAll([
          'title', 'category', 'startAt', 'endAt', 'allDay',
          'description', 'location', 'ownerId'
        ])
        && data.keys().hasOnly([
          'title', 'category', 'startAt', 'endAt', 'allDay',
          'description', 'location', 'ownerId'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 120
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 40
        && data.startAt is timestamp
        && data.endAt is timestamp
        && data.startAt <= data.endAt
        && data.allDay is bool
        && data.description is string
        && data.description.size() <= 1000
        && data.location is string
        && data.location.size() <= 200
        && data.ownerId is string
        && data.ownerId.size() > 0
        && data.ownerId.size() <= 128;
    }

    // Top-level events are queried with ownerId == the authenticated UID.
    // ownerId is assigned at creation and cannot be changed afterwards.
    match /events/{eventId} {
      allow read: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && hasValidEventFields(request.resource.data);
      allow update: if isAuthenticated()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && hasValidEventFields(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
